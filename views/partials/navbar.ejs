<header>

  <div class="shell header-inner">

    <div class="brand">

      <a href="/" style="text-decoration:none; color:inherit;">The Bookmark</a>

    </div>

    <% if (typeof showSearch !== "undefined" && showSearch) { %>

      <div class="search-container">

        <form method="GET" action="/" class="nav-search">

          <input type="text" name="search" placeholder="Search books..."

                 value="<%= searchQuery || '' %>">

          <details class="filter-dropdown">

            <summary>Filters</summary>

            <div class="filter-menu">

              <label>Genre</label>

              <select name="genre">

                <option value="" <%= (typeof genre === "undefined" || !genre) ? "selected" : "" %>>All Genres</option>

                <option value="Mystery" <%= genre === 'Mystery' ? 'selected' : '' %>>Mystery</option>

                <option value="Fantasy" <%= genre === 'Fantasy' ? 'selected' : '' %>>Fantasy</option>

                <option value="Non-fiction" <%= genre === 'Non-fiction' ? 'selected' : '' %>>Non-fiction</option>

                <option value="Romance" <%= genre === 'Romance' ? 'selected' : '' %>>Romance</option>

                <option value="Comics" <%= genre === 'Comics' ? 'selected' : '' %>>Comics</option>

              </select>



              <label>Price Range</label>

              <select name="priceRange">

                <option value="" <%= (typeof priceRange === "undefined" || !priceRange) ? "selected" : "" %>>Any Price</option>

                <option value="0-15" <%= priceRange === '0-15' ? 'selected' : '' %>>Under $15</option>

                <option value="15-20" <%= priceRange === '15-20' ? 'selected' : '' %>>$15 - $20</option>

                <option value="20+" <%= priceRange === '20+' ? 'selected' : '' %>>Over $20</option>

              </select>



              <label>Sort By</label>

              <select name="sortBy">

                <option value="title_asc" <%= (typeof sortBy === "undefined" || sortBy === 'title_asc') ? 'selected' : '' %>>Title A-Z</option>

                <option value="title_desc" <%= sortBy === 'title_desc' ? 'selected' : '' %>>Title Z-A</option>

                <option value="price_asc" <%= sortBy === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>

                <option value="price_desc" <%= sortBy === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>

              </select>



              <div class="filter-actions">

                <button type="submit">Apply</button>

                <button type="button" onclick="location.href='/'">Clear</button>

              </div>

            </div>

          </details>

          <button type="submit" class="nav-search-btn">Search</button>

        </form>

      </div>

    <% } %>

        <nav>
      <a href="/">Home &#x1F3E0;</a>
      <% if (user) { %>
        <a href="/profile">Profile &#x1F464;</a>
        <a href="/logout">Logout &#x1F6AA;</a>
      <% } else { %>
        <a href="/login">Login &#x1F510;</a>
        <a href="/register">Register &#x270D;&#xFE0F;</a>
      <% } %>

        <% if (user && (typeof showMenu === "undefined" || showMenu !== false)) { %>
        <% const hasUnreadNotifications = typeof unreadNotificationCount === "number" && unreadNotificationCount > 0; %>
        <% const hasUnreadOrders = typeof unreadOrdersCount === "number" && unreadOrdersCount > 0; %>
        <% const hasUnreadRefunds = typeof unreadRefundsCount === "number" && unreadRefundsCount > 0; %>
        <% const hasUnreadOffers = typeof unreadOffersCount === "number" && unreadOffersCount > 0; %>
        <details class="nav-menu-dropdown">
          <summary>Menu &#9776;<% if (hasUnreadNotifications) { %> <span class="nav-new-badge" data-new-badge data-badge-kind="menu">NEW</span><% } %></summary>
          <div class="nav-menu-panel">
          <% if (user && user.role === "buyer") { %>
            <a href="/wishlist">Wishlist &#x1F496;</a>
            <a href="/wallet">Wallet &#x1F4B3;</a>
            <a href="/membership">Membership &#x1F4B0;</a>
            <a href="/offers" data-mark-read data-mark-types="offer_update">
              Offers &#x1F4AC;<% if (hasUnreadOffers) { %> <span class="nav-new-badge nav-new-badge-inline" data-new-badge data-badge-kind="offers">NEW</span><% } %>
            </a>
          <% } %>
            <% if (user) { %>
              <a href="/orders" data-mark-read data-mark-types="<%= user.role === 'seller' ? 'order_new' : 'delivery_update,refund_update' %>">
                Orders &#x1F4E6;<% if (hasUnreadOrders) { %> <span class="nav-new-badge nav-new-badge-inline" data-new-badge data-badge-kind="orders">NEW</span><% } %>
              </a>
            <% } %>
          <% if (user && user.role === "admin") { %>
              <a href="/admin/users">Admin &#x1F6E1;&#xFE0F;</a>
              <a href="/seller/books">Manage Books &#x1F4DA;</a>
            <% } else if (user && user.role === "seller") { %>
              <a href="/seller/books">Manage Books &#x1F4DA;</a>
              <a href="/seller/offers" data-mark-read data-mark-types="offer_request">
                Offers &#x1F4AC;<% if (hasUnreadOffers) { %> <span class="nav-new-badge nav-new-badge-inline" data-new-badge data-badge-kind="offers">NEW</span><% } %>
              </a>
              <a href="/seller/refunds" data-mark-read data-mark-types="refund_request">
                Refunds &#x1F4B8;<% if (hasUnreadRefunds) { %> <span class="nav-new-badge nav-new-badge-inline" data-new-badge data-badge-kind="refunds">NEW</span><% } %>
              </a>
              <a href="/seller/dashboard" data-mark-read data-mark-types="refund_request">
                Dashboard &#x1F3E0;<% if (hasUnreadRefunds) { %> <span class="nav-new-badge nav-new-badge-inline" data-new-badge data-badge-kind="refunds">NEW</span><% } %>
              </a>
            <% } %>
            <% if (!user) { %>
              <a href="/login">Login &#x1F510;</a>
              <a href="/register">Register &#x270D;&#xFE0F;</a>
            <% } %>
          </div>
        </details>
      <% } %>
    </nav>

  </div>

</header>



<script>
  (() => {
    const badges = document.querySelectorAll("[data-new-badge]");
    if (!badges.length) return;
    const targets = document.querySelectorAll("[data-mark-read]");
    if (!targets.length) return;
    const markRead = (types) => fetch("/notifications/mark-read", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ types })
    }).catch(() => {});
    targets.forEach((target) => {
      target.addEventListener("click", () => {
        const typesAttr = target.getAttribute("data-mark-types") || "";
        const types = typesAttr.split(",").map((t) => t.trim()).filter(Boolean);
        if (types.length) {
          if (types.includes("refund_request")) {
            document.querySelectorAll('[data-new-badge][data-badge-kind="refunds"]').forEach((badge) => badge.remove());
          }
          if (types.includes("order_new") || types.includes("delivery_update") || types.includes("refund_update")) {
            document.querySelectorAll('[data-new-badge][data-badge-kind="orders"]').forEach((badge) => badge.remove());
          }
          if (types.includes("offer_request") || types.includes("offer_update")) {
            document.querySelectorAll('[data-new-badge][data-badge-kind="offers"]').forEach((badge) => badge.remove());
          }
          markRead(types);
        } else {
          document.querySelectorAll("[data-new-badge]").forEach((badge) => badge.remove());
          markRead([]);
        }

        const remaining = document.querySelectorAll('[data-new-badge]:not([data-badge-kind="menu"])');
        if (!remaining.length) {
          document.querySelectorAll('[data-new-badge][data-badge-kind="menu"]').forEach((badge) => badge.remove());
        }
      });
    });
  })();
</script>

<% if (user && user.role === "buyer") { %>
  <a class="floating-cart" href="/cart" aria-label="Open cart">

    <span class="floating-cart-icon">&#x1F6D2;</span>

    <% if (typeof cartCount === "number" && cartCount > 0) { %>

      <span class="floating-cart-badge"><%= cartCount %></span>

    <% } %>

  </a>

<% } %>

