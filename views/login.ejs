<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="auth-body">
  <div class="auth-card auth-card-wide">
    <h1>Welcome to The Bookmark</h1>
    <p class="auth-muted">Login to your account</p>

    <div class="auth-tabs">
      <a class="auth-tab active" href="/login">Login</a>
      <a class="auth-tab" href="/register">Register</a>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div>
        <label for="email">Username</label>
        <input id="email" name="email" type="email" placeholder="Enter your username" required>
      </div>
      <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="********" required>
      </div>
      <button class="auth-cta" type="submit">Login</button>
    </form>

    <p class="auth-muted">Don't have an account? <a href="/register">Register here</a></p>
  </div>
</body>
</html>
