<header>
  <div class="shell header-inner">
    <div class="brand">The Bookmark</div>
    <nav>
      <a href="/">Home</a>
      <a href="/cart">Cart</a>
      <% if (user) { %>
        <% if (user.role === "admin") { %>
          <a href="/admin/users">Admin</a>
        <% } else { %>
          <a href="/profile">Profile</a>
        <% } %>
        <a href="/logout">Logout</a>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
      <% } %>
    </nav>
  </div>
</header>
