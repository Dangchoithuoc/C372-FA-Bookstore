<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Books - The Bookmark</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include("../partials/navbar", { user: user }) %>

    <main class="seller-shell">
        <div class="seller-header">
            <h1>Manage Your Books</h1>
            <a href="/seller/books/new" class="cta">Add New Book</a>
        </div>

        <% if (books.length > 0) { %>
            <table class="seller-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Genre</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% books.forEach(book => { %>
                        <tr>
                            <td>#<%= book.book_id %></td>
                            <td><strong><%= book.title %></strong></td>
                            <td><%= book.author %></td>
                            <td><%= book.genre || '-' %></td>
                            <td>$<%= parseFloat(book.price).toFixed(2) %></td>
                            <td>
                                <div class="seller-actions">
                                    <a href="/seller/books/<%= book.book_id %>/edit" class="admin-btn">Edit</a>
                                    <form method="POST" action="/seller/books/<%= book.book_id %>/delete">
                                        <button type="submit" class="admin-btn admin-danger"
                                                onclick="return confirm('Are you sure? This cannot be undone.')">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="seller-empty">
                <h3>No books yet</h3>
                <p>Start by adding your first book to sell.</p>
                <a href="/seller/books/new" class="cta" style="margin-top: 20px;">Add Your First Book</a>
            </div>
        <% } %>

        <div class="seller-link-row">
            <a href="/seller/dashboard">← Back to Dashboard</a>
            <a href="/">← Back to Homepage</a>
        </div>
    </main>
</body>
</html>
