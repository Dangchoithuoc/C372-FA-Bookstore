<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .role-selection { margin: 16px 0; }
    .role-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-top: 10px;
    }
    .role-option {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
      background: var(--panel);
      color: var(--highlight);
    }
    .role-option:hover {
      border-color: rgba(180, 137, 44, 0.45);
      background: #f7f1e6;
    }
    .role-option.selected {
      border-color: rgba(180, 137, 44, 0.6);
      background: #f0e4d2;
    }
    .role-option input[type="radio"] { display: none; }
    .role-icon { font-size: 22px; margin-bottom: 6px; }
    .role-name { font-weight: 700; margin-bottom: 4px; }
    .role-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.3; }
    .invite-code-section {
      margin-top: 16px;
      padding: 14px;
      background: #f7f1e6;
      border-radius: 12px;
      border: 1px solid var(--border);
    }
    .invite-note {
      font-size: 0.85rem;
      color: var(--muted);
      margin-top: 6px;
    }
    .recaptcha-wrapper {
      margin-top: 16px;
      text-align: center;
    }
    .recaptcha-warning {
      color: #b91c1c;
      font-size: 0.9rem;
      margin-top: 8px;
    }
    .password-feedback {
      display: block;
      margin-top: 5px;
      font-size: 0.85rem;
      color: var(--muted);
    }
  </style>
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="pill">The Bookmark</div>
    <h1>Create your account</h1>
    <p class="auth-muted">Join our community using your security code.</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/register" id="registerForm">
      <div>
        <label for="name">Full name</label><br>
        <input id="name" name="name" type="text" placeholder="Alex Tan" 
               value="<%= name || '' %>" 
               minlength="2"
               required>
      </div>
      <div>
        <label for="email">Email</label><br>
        <input id="email" name="email" type="email" placeholder="you@example.com" 
               value="<%= email || '' %>" 
               required>
      </div>
      <div>
        <label for="password">Password</label><br>
        <div class="password-field">
          <input id="password" name="password" type="password" class="password-input" placeholder="********" 
                 minlength="6" 
                 required>
          <label class="password-toggle">
            <input type="checkbox" class="password-toggle-input" data-target="password">
            Show password
          </label>
        </div>
        <small class="password-feedback" id="passwordFeedback"></small>
      </div>
      
      <div class="role-selection">
        <label>Account Type</label><br>
        <div class="role-options">
          <label class="role-option" for="role-buyer">
            <input type="radio" id="role-buyer" name="role" value="buyer" <%= role === 'buyer' ? 'checked' : '' %>>
            <div class="role-icon">📚</div>
            <div class="role-name">Buyer</div>
            <div class="role-desc">Browse & purchase books</div>
          </label>
          
          <label class="role-option" for="role-seller">
            <input type="radio" id="role-seller" name="role" value="seller" <%= role === 'seller' ? 'checked' : '' %>>
            <div class="role-icon">🏪</div>
            <div class="role-name">Seller</div>
            <div class="role-desc">Sell your own books</div>
          </label>
        </div>
        
        <div class="invite-code-section">
          <div class="invite-code-field">
            <label for="inviteCode">Security Code</label><br>
            <input id="inviteCode" name="inviteCode" type="text" 
                   placeholder="Enter security code for your role" 
                   required>
            <p class="invite-note">
              Buyer security code: <strong>BUYER123</strong> | 
              Seller security code: <strong>SELLER123</strong>
            </p>
          </div>
        </div>
        
        <div class="recaptcha-wrapper">
          <% const recaptchaKey = typeof recaptchaSiteKey !== 'undefined' ? recaptchaSiteKey : ''; %>
          <% if (recaptchaKey) { %>
            <div class="g-recaptcha" data-sitekey="<%= recaptchaKey %>"></div>
          <% } else { %>
            <p class="recaptcha-warning">reCAPTCHA is not configured. Please contact the administrator.</p>
          <% } %>
        </div>
      </div>

      <button class="auth-cta" type="submit">Register</button>
    </form>

    <p class="auth-muted">Already have an account? <a href="/login">Log in</a></p>
    <p class="auth-muted"><a href="/">Back to homepage</a></p>
  </div>

  <script>
    // Role selection styling
    document.querySelectorAll('.role-option').forEach(option => {
      option.addEventListener('click', function() {
        // Remove selected class from all options
        document.querySelectorAll('.role-option').forEach(opt => {
          opt.classList.remove('selected');
        });
        // Add selected class to clicked option
        this.classList.add('selected');
        // Check the radio button
        this.querySelector('input[type="radio"]').checked = true;
      });
    });

    // Set initial selected state
    document.querySelectorAll('.role-option').forEach(option => {
      if (option.querySelector('input[type="radio"]').checked) {
        option.classList.add('selected');
      }
    });

    // Password strength indicator (visual feedback only)
    const passwordInput = document.getElementById('password');
    const passwordFeedback = document.getElementById('passwordFeedback');

    passwordInput.addEventListener('input', function() {
      const length = this.value.length;
      if (length === 0) {
        passwordFeedback.textContent = '';
        passwordFeedback.style.color = '';
      } else if (length < 6) {
        passwordFeedback.textContent = `${length}/6 characters`;
        passwordFeedback.style.color = '#dc3545';
      } else {
        passwordFeedback.textContent = '✓ Good password';
        passwordFeedback.style.color = '#28a745';
      }
    });

    // No form validation - let HTML5 and backend handle it
    // This prevents conflicts with your existing backend validation

    document.querySelectorAll(".password-toggle-input").forEach(toggle => {
      toggle.addEventListener("change", () => {
        const input = document.getElementById(toggle.dataset.target);
        if (!input) return;
        input.type = toggle.checked ? "text" : "password";
      });
    });
  </script>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</body>
</html>
