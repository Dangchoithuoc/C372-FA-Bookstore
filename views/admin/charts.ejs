<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Charts | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-ui">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-logo">Control Room</div>
      <nav class="admin-nav">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/books">Books</a>
        <a href="/admin/orders">Orders</a>
        <a class="active" href="/admin/charts">Charts</a>
      </nav>
    </aside>

    <main class="admin-main">
      <div class="admin-topbar">
        <div>
          <h1>Orders & Sales Charts</h1>
          <p class="admin-sub">Switch between orders, revenue, and top performers.</p>
        </div>
        <div class="admin-actions">
          <a class="admin-btn" href="/logout">Log out</a>
          <a class="admin-btn" href="/admin/dashboard">Back to Dashboard</a>
        </div>
      </div>

      <div class="admin-card">
        <div class="admin-toolbar">
          <div class="admin-actions" id="adminChartButtons">
            <button class="admin-btn admin-btn-primary" type="button" data-chart="orders">Orders</button>
            <button class="admin-btn" type="button" data-chart="revenue">Revenue</button>
            <button class="admin-btn" type="button" data-chart="buyers">Top Buyers</button>
            <button class="admin-btn" type="button" data-chart="sellers">Top Sellers</button>
          </div>
          <div class="admin-muted" id="adminChartTitle">Orders (last 30 days)</div>
        </div>
        <canvas id="adminChart" height="130"></canvas>
        <div id="adminChartError" class="admin-muted" style="display:none; margin-top:10px;"></div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    if (!window.Chart) {
      const err = document.getElementById("adminChartError");
      err.style.display = "block";
      err.textContent = "Charts failed to load (Chart.js not available). Check your network or allow the CDN.";
    }

    const dailyData = <%- JSON.stringify(chartDaily || []) %>;
    const topBuyers = <%- JSON.stringify(chartTopBuyers || []) %>;
    const topSellers = <%- JSON.stringify(chartTopSellers || []) %>;

    const labelsDaily = dailyData.map(d => {
      const date = new Date(d.day);
      return isNaN(date) ? String(d.day) : date.toLocaleDateString();
    });
    const ordersSeries = dailyData.map(d => Number(d.orders || 0));
    const revenueSeries = dailyData.map(d => Number(d.revenue || 0));

    const buyerLabels = topBuyers.map(b => b.username);
    const buyerValues = topBuyers.map(b => Number(b.total_spend || 0));

    const sellerLabels = topSellers.map(s => s.username);
    const sellerValues = topSellers.map(s => Number(s.total_sales || 0));

    const ctx = document.getElementById("adminChart");
    let chart = null;
    if (window.Chart) {
      chart = new Chart(ctx, {
        type: "line",
        data: {
          labels: labelsDaily,
        datasets: [{
          label: "Orders",
          data: ordersSeries,
          borderColor: "#2563eb",
          backgroundColor: "rgba(37, 99, 235, 0.15)",
          tension: 0.3,
          fill: true
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: { grid: { display: false } },
          y: { beginAtZero: true }
        }
      }
    });
    }

    function setChart(type) {
      if (!chart) return;
      const title = document.getElementById("adminChartTitle");
      const err = document.getElementById("adminChartError");
      err.style.display = "none";

      if (type === "revenue") {
        chart.config.type = "line";
        chart.data.labels = labelsDaily;
        chart.data.datasets = [{
          label: "Revenue",
          data: revenueSeries,
          borderColor: "#0ea5e9",
          backgroundColor: "rgba(14, 165, 233, 0.15)",
          tension: 0.3,
          fill: true
        }];
        title.textContent = "Revenue (last 30 days)";
        if (!revenueSeries.length) {
          err.style.display = "block";
          err.textContent = "No revenue data available yet.";
        }
      } else if (type === "buyers") {
        chart.config.type = "bar";
        chart.data.labels = buyerLabels;
        chart.data.datasets = [{
          label: "Top Buyers",
          data: buyerValues,
          backgroundColor: "rgba(37, 99, 235, 0.45)",
          borderColor: "#2563eb"
        }];
        title.textContent = "Top Buyers (total spend)";
        if (!buyerValues.length) {
          err.style.display = "block";
          err.textContent = "No buyer data available yet.";
        }
      } else if (type === "sellers") {
        chart.config.type = "bar";
        chart.data.labels = sellerLabels;
        chart.data.datasets = [{
          label: "Top Sellers",
          data: sellerValues,
          backgroundColor: "rgba(14, 165, 233, 0.45)",
          borderColor: "#0ea5e9"
        }];
        title.textContent = "Top Sellers (total sales)";
        if (!sellerValues.length) {
          err.style.display = "block";
          err.textContent = "No seller data available yet.";
        }
      } else {
        chart.config.type = "line";
        chart.data.labels = labelsDaily;
        chart.data.datasets = [{
          label: "Orders",
          data: ordersSeries,
          borderColor: "#2563eb",
          backgroundColor: "rgba(37, 99, 235, 0.15)",
          tension: 0.3,
          fill: true
        }];
        title.textContent = "Orders (last 30 days)";
        if (!ordersSeries.length) {
          err.style.display = "block";
          err.textContent = "No order data available yet.";
        }
      }
      chart.update();
    }

    const buttons = document.querySelectorAll("#adminChartButtons [data-chart]");
    buttons.forEach(btn => {
      btn.addEventListener("click", () => {
        buttons.forEach(b => b.classList.remove("admin-btn-primary"));
        btn.classList.add("admin-btn-primary");
        setChart(btn.dataset.chart);
      });
    });
    setChart("orders");
  </script>
</body>
</html>
