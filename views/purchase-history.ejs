<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || "Purchase History" %> | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="buyer-ui">
  <%- include("partials/navbar", { user: user }) %>

  <main class="profile-shell">
    <section class="profile-card">
      <div class="pill">Orders</div>
      <h1><%= pageTitle || "Purchase history" %></h1>
      <p class="muted"><%= pageSubtitle || "Review your past orders and the books you purchased." %></p>

      <% if (!orders || orders.length === 0) { %>
        <div class="muted"><%= emptyMessage || "No orders yet. Once you check out, they will appear here." %></div>
      <% } else { %>
        <div class="order-list">
          <% orders.forEach(order => { %>
            <article class="order-card">
              <div class="order-meta">
                <div>
                  <small>Order</small>
                  <div>#<%= order.id %></div>
                </div>
                <div>
                  <small>Date</small>
                  <div><%= new Date(order.order_date).toLocaleString("en-SG", { year: "numeric", month: "2-digit", day: "2-digit", hour: "numeric", minute: "2-digit" }) %></div>
                </div>
                <div>
                  <small>Total</small>
                  <div>$<%= order.total_price.toFixed(2) %></div>
                </div>
                <% if (order.buyer_name || order.buyer_email) { %>
                  <div>
                    <small>Buyer</small>
                    <div>
                      <%= order.buyer_name || "Unknown" %>
                      <% if (order.buyer_email) { %>
                        (<%= order.buyer_email %>)
                      <% } %>
                    </div>
                  </div>
                <% } %>
                <% if (order.payment_method) { %>
                  <div>
                    <small>Payment</small>
                    <div>Paid via <%= order.payment_method %></div>
                  </div>
                <% } %>
              </div>
              <div class="order-items">
                <% order.items.forEach(item => { %>
                  <div class="order-item">
                    <img src="<%= item.coverImage || '/images/placeholder.svg' %>" alt="<%= item.title %> cover">
                    <div>
                      <div class="order-item-title"><%= item.title %></div>
                      <div class="muted"><%= item.author %> · <%= item.genre || 'General' %></div>
                      <% if (user && user.role === "seller") { %>
                        <form method="POST" action="/orders/items/<%= item.order_item_id %>/delivery" class="delivery-status" data-auto-submit="true">
                          <div class="muted delivery-status-label">Delivery status</div>
                          <div class="delivery-status-options">
                            <% (deliveryStatuses || []).forEach(status => { %>
                              <label class="delivery-status-option">
                                <input type="radio" name="status" value="<%= status %>" <%= status === item.delivery_status ? "checked" : "" %>>
                                <span><%= status %></span>
                              </label>
                            <% }) %>
                          </div>
                        </form>
                      <% } else { %>
                        <div class="delivery-status-pill <%= (item.delivery_status || 'Pending').toLowerCase() %>">
                          <strong>Delivery:</strong> <%= item.delivery_status || "Pending" %>
                        </div>
                      <% } %>

                      <% if (item.review_rating) { %>
                        <div class="review-readonly">
                          <strong>Review:</strong>
                          <span class="review-stars"><%= "★".repeat(item.review_rating) %><%= "☆".repeat(5 - item.review_rating) %></span>
                          <% if (item.review_comment) { %>
                            <div class="muted"><%= item.review_comment %></div>
                          <% } %>
                          </div>
                          <% if (user && user.role === "buyer") { %>
                            <div class="review-actions">
                              <a class="cta" href="/orders/items/<%= item.order_item_id %>/review">Edit review</a>
                            </div>
                          <% } %>
                        <% } else if (user && user.role === "buyer" && item.delivery_status === "Delivered") { %>
                        <div class="review-actions">
                          <a class="cta" href="/orders/items/<%= item.order_item_id %>/review">Leave a review ⭐</a>
                        </div>
                      <% } %>

                      <% if (user && user.role === "buyer") { %>
                        <% if (item.refund_status) { %>
                          <div class="review-readonly">
                            <strong>Refund:</strong>
                            <span class="admin-pill"><%= item.refund_status %></span>
                            <span class="muted">(<%= item.refund_method === 'wallet' ? 'Wallet' : 'Original method' %>)</span>
                          </div>
                        <% } else if (item.delivery_status === "Delivered") { %>
                          <div class="review-actions">
                            <a class="cta" href="/orders/items/<%= item.order_item_id %>/refund">Request refund 💸</a>
                          </div>
                        <% } %>
                      <% } %>
                    </div>
                    <div class="order-item-price">$<%= item.price.toFixed(2) %></div>
                  </div>
                <% }) %>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
  <script>
    document.querySelectorAll("[data-auto-submit]").forEach(form => {
      form.addEventListener("change", () => form.submit());
    });
  </script>
</body>
</html>
