<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Charts | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-ui">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-logo">Control Room</div>
      <nav class="admin-nav">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/books">Books</a>
        <a href="/admin/orders">Orders</a>
        <a class="active" href="/admin/charts">Charts</a>
      </nav>
    </aside>

    <main class="admin-main">
      <div class="admin-topbar">
        <div>
          <h1>Orders & Sales Charts</h1>
          <p class="admin-sub">Switch between orders, revenue, and top performers.</p>
        </div>
        <div class="admin-actions">
          <a class="admin-btn" href="/logout">Log out</a>
          <a class="admin-btn" href="/admin/dashboard">Back to Dashboard</a>
        </div>
      </div>

      <div class="admin-card">
        <h3>Revenue (last 120 minutes)</h3>
        <canvas id="adminRevenueChart" height="120"></canvas>
        <div id="adminRevenueError" class="admin-muted" style="display:none; margin-top:10px;"></div>
      </div>

      <div class="admin-card">
        <h3>Top Sellers (total sales)</h3>
        <canvas id="adminSellersChart" height="120"></canvas>
        <div id="adminSellersError" class="admin-muted" style="display:none; margin-top:10px;"></div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    if (!window.Chart) {
      const err = document.getElementById("adminChartError");
      err.style.display = "block";
      err.textContent = "Charts failed to load (Chart.js not available). Check your network or allow the CDN.";
    }

    const dailyData = <%- JSON.stringify(chartDaily || []) %>;
    const topBuyers = <%- JSON.stringify(chartTopBuyers || []) %>;
    const topSellers = <%- JSON.stringify(chartTopSellers || []) %>;

    const labelsDaily = dailyData.map(d => {
      const date = new Date(d.minute);
      return isNaN(date) ? String(d.minute) : date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    });
    const ordersSeries = dailyData.map(d => Number(d.orders || 0));
    const revenueSeries = dailyData.map(d => Number(d.revenue || 0));

    const buyerLabels = topBuyers.map(b => b.username);
    const buyerValues = topBuyers.map(b => Number(b.total_spend || 0));

    const sellerLabels = topSellers.map(s => s.username);
    const sellerValues = topSellers.map(s => Number(s.total_sales || 0));

    function createLineChart(id, label, labels, data, color) {
      const canvas = document.getElementById(id);
      if (!canvas || !window.Chart) return null;
      return new Chart(canvas, {
        type: "line",
        data: {
          labels,
          datasets: [{
            label,
            data,
            borderColor: color,
            backgroundColor: color.replace("1)", "0.18)").replace("rgb", "rgba"),
            tension: 0.3,
            fill: true
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { x: { grid: { display: false } }, y: { beginAtZero: true } }
        }
      });
    }

    function createBarChart(id, label, labels, data, color) {
      const canvas = document.getElementById(id);
      if (!canvas || !window.Chart) return null;
      return new Chart(canvas, {
        type: "bar",
        data: {
          labels,
          datasets: [{
            label,
            data,
            backgroundColor: color.replace("1)", "0.45)").replace("rgb", "rgba"),
            borderColor: color
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { x: { grid: { display: false } }, y: { beginAtZero: true } }
        }
      });
    }

    const revenueError = document.getElementById("adminRevenueError");
    const sellersError = document.getElementById("adminSellersError");

    createLineChart("adminRevenueChart", "Revenue", labelsDaily, revenueSeries, "rgb(124, 63, 43)");
    if (!revenueSeries.length && revenueError) {
      revenueError.style.display = "block";
      revenueError.textContent = "No revenue data available yet.";
    }

    createBarChart("adminSellersChart", "Top Sellers", sellerLabels, sellerValues, "rgb(124, 63, 43)");
    if (!sellerValues.length && sellersError) {
      sellersError.style.display = "block";
      sellersError.textContent = "No seller data available yet.";
    }
  </script>
</body>
</html>
