<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Books | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-ui">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-logo">Control Room</div>
      <nav class="admin-nav">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/users">Users</a>
        <a class="active" href="/admin/books">Books</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/charts">Charts</a>
        <a href="/admin/refunds">Refunds</a>
      </nav>
    </aside>

    <main class="admin-main">
      <div class="admin-topbar admin-page-header">
        <div>
          <h1 class="admin-page-title">Catalog Oversight</h1>
          <p class="admin-page-sub">Monitor listings and seller contributions.</p>
        </div>
        <div class="admin-actions">
          <a class="admin-btn" href="/logout">Log out</a>
          <a class="admin-btn" href="/admin/dashboard">Back to Dashboard</a>
        </div>
      </div>

      <div class="admin-toolbar">
        <div class="admin-search">
          <form method="GET" action="/admin/books" class="admin-search-form">
            <input type="text"
                   name="bookSearch"
                   placeholder="Search books by title, author, or seller"
                   value="<%= typeof bookSearch !== 'undefined' ? bookSearch : '' %>">
            <button type="submit">Search</button>
          </form>
          <span class="admin-muted">
            <% if (bookSearch) { %>
              Showing results for "<%= bookSearch %>"
            <% } else { %>
              Search by title, author, or seller
            <% } %>
          </span>
        </div>
        <div>
          <% if (success) { %>
            <span class="admin-pill"><%= success %></span>
          <% } %>
          <% if (error) { %>
            <span class="admin-pill admin-danger"><%= error %></span>
          <% } %>
        </div>
      </div>

      <div class="admin-section">
      <% if (!books || books.length === 0) { %>
        <div class="admin-empty">No books found.</div>
      <% } else { %>
      <table class="admin-table admin-table-compact">
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Seller</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(function(b) { %>
            <tr>
              <td>#<%= b.book_id %></td>
              <td><%= b.title %></td>
              <td><%= b.author %></td>
              <td><%= b.seller_name %></td>
              <td><%= b.genre || "-" %></td>
              <td>$<%= parseFloat(b.price || 0).toFixed(2) %></td>
              <td><%= typeof b.stock === 'number' ? b.stock : (b.stock || 0) %></td>
              <td>
                <form method="POST" action="/admin/books/<%= b.book_id %>/delete" onsubmit="return confirm('Delete this book?');">
                  <button class="admin-btn admin-danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
      </div>
    </main>
  </div>
</body>
</html>
