<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= book.title %> | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="buyer-ui">
  <%- include("partials/navbar", { user: user }) %>

  <main class="detail-shell">
    <div class="detail-grid">
      <div class="detail-cover">
        <img src="<%= book.coverImage %>" alt="Cover of <%= book.title %>">
      </div>
      <div class="detail-info">
        <div class="eyebrow">
          Featured title
        </div>
        <h1><%= book.title %></h1>
        <p class="muted">
          by <strong><%= book.author %></strong> · Seller:
          <% if (book.sellerId) { %>
            <a class="seller-link" href="/sellers/<%= book.sellerId %>"><%= book.sellerName %></a>
          <% } else { %>
            <%= book.sellerName %>
          <% } %>
        </p>
        <p class="price">$<%= book.price.toFixed(2) %></p>
        <% if (book.tagline) { %>
          <p><%= book.tagline %></p>
        <% } %>
        <p class="muted"><%= book.description %></p>
        <% if (user && user.role === "buyer") { %>
          <form method="POST" action="/cart/add" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <input type="hidden" name="bookId" value="<%= book.id %>">
            <input type="hidden" name="title" value="<%= book.title %>">
            <input type="hidden" name="price" value="<%= book.price %>">
            <button class="cta" type="submit">Add to cart</button>
            <button class="cta" type="button" onclick="location.href='/cart'">View cart</button>
          </form>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
