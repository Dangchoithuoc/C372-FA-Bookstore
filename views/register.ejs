<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="auth-body">
  <div class="auth-card auth-card-wide">
    <h1>Welcome to The Bookmark</h1>
    <p class="auth-muted">Create your account</p>

    <div class="auth-tabs">
      <a class="auth-tab" href="/login">Login</a>
      <a class="auth-tab active" href="/register">Register</a>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/register">
      <div>
        <label for="name">Username</label>
        <input id="name" name="name" type="text" placeholder="Alex Tan" required>
      </div>
      <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" placeholder="you@example.com" required>
      </div>
      <div>
        <label for="role">Role</label>
        <select id="role" name="role" required>
          <option value="buyer">Buyer</option>
          <option value="seller">Seller</option>
        </select>
      </div>
      <div>
        <label for="contact_number">Contact number</label>
        <input id="contact_number" name="contact_number" type="text" placeholder="91234567">
      </div>
      <div>
        <label for="address">Address</label>
        <input id="address" name="address" type="text" placeholder="Block 123, Street 4">
      </div>
      <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="********" required>
      </div>
      <button class="auth-cta" type="submit">Register</button>
    </form>

    <p class="auth-muted">Already have an account? <a href="/login">Login here</a></p>
  </div>
</body>
</html>
