<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart | The Bookmark</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="buyer-ui">
  <%- include("partials/navbar", { user: user }) %>

  <main class="shell" style="padding: 20px 0 60px;">
    <div class="row" style="margin-bottom:16px;">
      <h1>Your Cart</h1>
      <form action="/cart/clear" method="POST" style="margin:0;">
        <button class="cta" type="submit">Clear cart 🧹</button>
      </form>
    </div>
    <% if (!cart || cart.length === 0) { %>
      <p class="muted">Your cart is empty. <a href="/">Browse books</a>.</p>
    <% } else { %>
      <div class="card cart-card">
        <div class="row" style="margin-bottom:12px;">
          <strong>Items</strong>
          <span class="muted">Total: $<%= total %></span>
        </div>
        <div class="grid cart-grid">
          <strong>Book</strong>
          <strong class="center">Price</strong>
          <strong class="center">Qty</strong>
          <strong class="center">Remove</strong>
          <% cart.forEach(function(item) { %>
            <div class="cart-item-title">
              <img class="cart-thumb" src="<%= item.coverImage || '/images/placeholder.svg' %>" alt="<%= item.title %> cover">
              <div><%= item.title %></div>
            </div>
            <div class="center">$<%= Number(item.price || 0).toFixed(2) %></div>
            <div class="center">
              <form action="/cart/update" method="POST" style="display:flex; gap:6px; justify-content:center;">
                <input type="hidden" name="id" value="<%= item.id %>">
                <input type="number" name="qty" value="<%= item.qty %>" min="1" max="<%= item.stock || item.qty %>" style="width:70px;">
                <button type="submit" class="cta" style="padding:8px 12px;">Update 🔄</button>
              </form>
              <% if (item.stock === 0) { %>
                <div class="muted" style="margin-top:6px;">Out of stock</div>
              <% } %>
            </div>
            <div class="center">
              <form action="/cart/remove" method="POST">
                <input type="hidden" name="id" value="<%= item.id %>">
                <button type="submit" class="cta cart-remove-btn" style="padding:8px 12px;">Remove 🗑️</button>
              </form>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="row" style="margin-top:18px;">
        <div>
          <a class="tag" href="/">Continue browsing</a>
        </div>
        <div class="row" style="gap:12px;">
          <div class="price" style="margin:0;">Subtotal: $<%= total %></div>
          <a class="cta" href="/checkout">Checkout ✅</a>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
