<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Command Center | The Bookmark</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-ui">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-logo">Control Room</div>
            <nav class="admin-nav">
                <a class="active" href="/admin/dashboard">Dashboard</a>
                <a href="/admin/users">Users</a>
                <a href="/admin/books">Books</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/charts">Charts</a>
        <a href="/admin/refunds">Refunds</a>
      </nav>
    </aside>

        <main class="admin-main">
            <div class="admin-topbar">
                <div>
                    <h1>Command Center</h1>
                    <p class="admin-sub">System overview and operational controls.</p>
                </div>
                <div class="admin-actions">
                    <a class="admin-btn" href="/logout">Log out</a>
                </div>
            </div>

            <section class="admin-grid">
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Top Buyers</h3>
                        <span class="admin-muted">Total spend</span>
                    </div>
                    <div class="admin-rank">
                        <% if (!topBuyers || topBuyers.length === 0) { %>
                          <div class="admin-muted">No buyer data yet.</div>
                        <% } else { %>
                          <% topBuyers.forEach((b, idx) => { %>
                            <div class="admin-rank-row">
                                <span class="admin-rank-num">#<%= idx + 1 %></span>
                                <span class="admin-rank-name"><%= b.username %></span>
                                <span class="admin-rank-value">$<%= Number(b.total_spend || 0).toFixed(2) %></span>
                            </div>
                          <% }) %>
                        <% } %>
                    </div>
                </div>
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Top Sellers</h3>
                        <span class="admin-muted">Total sales</span>
                    </div>
                    <div class="admin-rank">
                        <% if (!topSellers || topSellers.length === 0) { %>
                          <div class="admin-muted">No seller data yet.</div>
                        <% } else { %>
                          <% topSellers.forEach((s, idx) => { %>
                            <div class="admin-rank-row">
                                <span class="admin-rank-num">#<%= idx + 1 %></span>
                                <span class="admin-rank-name"><%= s.username %></span>
                                <span class="admin-rank-value">$<%= Number(s.total_sales || 0).toFixed(2) %></span>
                            </div>
                          <% }) %>
                        <% } %>
                    </div>
                </div>
            </section>

            <section class="admin-card admin-callout">
                <div class="admin-callout-body">
                    <div>
                        <h3>Sales Performance Reports</h3>
                        <p class="admin-muted">Generate a CSV report of daily orders and revenue.</p>
                    </div>
                    <div class="admin-actions">
                        <a class="admin-btn admin-btn-primary" href="/admin/reports/sales">Download Report</a>
                        <a class="admin-btn" href="/admin/charts">View Charts</a>
                    </div>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
